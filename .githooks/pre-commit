#!/usr/bin/env bash
# Apollo pre-commit hook — fast local-side gates that mirror deploy.sh
# preflight gates. Goal: catch class-bug regressions at `git commit` time
# instead of during deploy or at runtime.
#
# Activation (one-time per clone):
#   git config core.hooksPath .githooks
#
# Bypass for a single commit (rarely needed):
#   git commit --no-verify ...
#
# Add new gates BELOW. Keep each gate fast (<1s) — slow gates push
# operators toward --no-verify, which defeats the point.
set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ── Gate 1: YAML duplicate-key check (mirrors deploy.sh [5e/5]) ──────
# Only fires when data_gated_reviews.yaml is staged. Catches the
# 2026-05-24 SNDK class bug (YAML last-wins silently overwriting
# status fields) at commit time, not at deploy time.
if git diff --cached --name-only | grep -qx 'data_gated_reviews.yaml'; then
    if ! python scripts/preflight_yaml_dupe_keys.py >/dev/null 2>&1; then
        echo "✘ pre-commit: data_gated_reviews.yaml has duplicate keys within a review entry."
        echo "  Run: python scripts/preflight_yaml_dupe_keys.py"
        echo "  Fix the duplicates, re-stage, re-commit."
        echo "  (Bypass with: git commit --no-verify — only if you know what you're doing.)"
        exit 1
    fi
fi

# ── Gate 2: PLAN.md — the single source of truth (2026-06-16 consolidation) ──
# PLAN.md is THE plan: every task under a project, with an ETA + status, no past
# ETA on an open task, every open snapshot task filed. Fires when PLAN.md (or the
# snapshot it cross-checks) is staged — which is every CLOSE. Replaces the old
# BACKLOG/snapshot filing gate; makes "know the plan / no gaps" mechanical, not prose.
if git diff --cached --name-only | grep -qE '^(PLAN\.md|\.apollo_open_tasks\.json)$'; then
    if ! python scripts/check_plan.py; then
        echo "✘ pre-commit: PLAN.md failed the single-SoT gate (see above)."
        echo "  Every task needs a project + ETA + status; no open task may have a PAST ETA"
        echo "  (CLOSE rebumps stale dates); every open task must be filed. Fix, re-stage, re-commit."
        echo "  (Bypass with: git commit --no-verify — only if you know what you're doing.)"
        exit 1
    fi
fi

# ── Gate 3: CLAUDE.md size ceiling (#262, 2026-06-10) ─────────────────
# Fires when CLAUDE.md is staged. The file sat over its 40k hard ceiling
# from 2026-05-29 to 2026-06-10 because nothing checked it. FAIL >40k;
# warn >36k (graduate Recent entries to CHANGELOG.md before it's urgent).
if git diff --cached --name-only | grep -qx 'CLAUDE.md'; then
    size=$(git cat-file -s "$(git rev-parse :CLAUDE.md)")
    if [ "$size" -gt 40000 ]; then
        echo "✘ pre-commit: CLAUDE.md is ${size} chars (hard ceiling 40,000)."
        echo "  Graduate the oldest 'Changes Made — Recent' entries to CHANGELOG.md"
        echo "  (see 'Adding a Changes Made entry'), re-stage, re-commit."
        echo "  (Bypass with: git commit --no-verify — only if you know what you're doing.)"
        exit 1
    elif [ "$size" -gt 36000 ]; then
        echo "⚠ pre-commit: CLAUDE.md is ${size} chars (warn >36k, hard ceiling 40k)."
        echo "  Consider graduating old Recent entries to CHANGELOG.md soon."
    fi
fi

# ── Gate 4: no-silent-failures ratchet (#381 swallow-a-failure class) ──
# Fires when a scoped .py (agents/core/channels/shared) is staged. Blocks any NEW
# broad+silent except beyond the tracked baseline — the FMP-403 (#380) / theme-
# shadow-0-rows (#173) class where a real failure is swallowed behind a default.
# Escape genuine control-flow with '# loud-ok: <reason>'. Mirrors deploy.sh [5k/7].
if git diff --cached --name-only | grep -qE '^(agents|core|channels|shared)/.*\.py$'; then
    if ! python scripts/preflight_no_silent_failures.py >/dev/null 2>&1; then
        echo "✘ pre-commit: a NEW broad+silent except (swallowed failure) was introduced (#381)."
        echo "  Run: python scripts/preflight_no_silent_failures.py"
        echo "  Surface it (raise / log+alert / failure_policy.py decorator), or annotate"
        echo "  genuine control-flow with '# loud-ok: <reason>'. Do NOT bury it via --update-baseline."
        echo "  (Bypass with: git commit --no-verify — only if you know what you're doing.)"
        exit 1
    fi
fi

# ── Gate 5: gate-provenance ratchet (#358, ADR 0013 provenance rule) ──
# Fires when the provenance registry/checker/baseline, or one of the registered detector
# modules, is staged. Blocks any NEW cohort-shaping gate added without a source citation
# (docs/methodology/operator_shared_notes.md / an ADR / a setup SSoT / a docs/analysis
# writeup), plus STALE (renamed/removed constant) and DRIFT (live value silently no longer
# matches what the registry recorded) — both always hard-fail, never baseline-exempt.
# Known-uncited legacy gates are tracked debt (see scripts/gate_provenance_baseline.json);
# never bury a NEW one via --update-baseline.
if git diff --cached --name-only | grep -qE '^(scripts/gate_provenance_registry\.py|scripts/gate_provenance_baseline\.json|scripts/check_gate_provenance\.py|agents/market_intelligence/(anticipation|flag_detector|ninem_detector|ep_detector|db)\.py)$'; then
    if ! python -m scripts.check_gate_provenance >/dev/null 2>&1; then
        echo "✘ pre-commit: a cohort-shaping gate lacks a source citation, or drifted from the"
        echo "  registry's recorded value (#358, ADR 0013 provenance rule)."
        echo "  Run: python -m scripts.check_gate_provenance"
        echo "  Add a real citation (never fabricate one), or update the registry's value in the"
        echo "  SAME commit as a signed value change. Do NOT bury a new omission via --update-baseline."
        echo "  (Bypass with: git commit --no-verify — only if you know what you're doing.)"
        exit 1
    fi
fi

exit 0
