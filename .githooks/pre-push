#!/usr/bin/env bash
# Apollo pre-push hook — run the full test suite before pushing, mirroring CI
# (`python -m pytest tests/ -q`). Catches the class where a local SUBSET test run
# passes but the FULL suite (which CI runs) fails — the 2026-06-17 downgrade-digest
# mock regression that broke CI and spammed failure emails.
#
# Activation: `git config core.hooksPath .githooks` (one-time per clone; same setting
# the pre-commit hook already uses, so no extra step if pre-commit is active).
#
# Bypass a single push (emergency hotfix only): `git push --no-verify`.
#
# Only runs when the pushed commits touch Python OR a DATA FILE THE SUITE READS — a
# genuinely docs-only push still skips the suite so the gate doesn't train operators
# toward --no-verify. If the pushed range can't be determined, it runs the suite
# (fail-safe: a safety gate must not fail open).
#
# ⚠ THE DATA-FILE HALF EXISTS BECAUSE THE PYTHON-ONLY PREDICATE SHIPPED A RED CI
# (2026-08-06). Commit `a9d93eb` changed ONLY `data_gated_reviews.yaml` — zero .py
# files — so this hook skipped the suite and let through a push that broke
# `test_review_registry_dates_are_dates`, which READS that yaml. CI caught it; the
# local gate whose whole job is to mirror CI did not. CLAUDE.md already documented
# this exact gap for CLAUDE.md ("a docs-only push skips the pre-push pytest gate, so
# this only surfaces in CI") — it was a known papercut that simply bit a different
# file. Generalised here rather than patched for one filename.
#
# `tests/test_prepush_covers_test_read_data_files.py` keeps _DATA_RE honest: it scans
# tests/ for repo-root data reads and fails if any is not matched by this pattern, so
# the list cannot silently rot as new data-driven tests are added.
#
# ⚖ MEASURED COST OF WIDENING, so the trade-off is visible rather than assumed (/simplify
# efficiency pass, 2026-08-07, over the last 14 days / 336 commits): 144 (43%) touched .py
# and ran the suite before and after; 172 (51%) touched ONLY listed data files and now run
# it where they previously skipped; 20 (6%) still skip. So the full-suite rate on push goes
# 43% -> 94%, ≈86 min of added suite time over 14 days (~6 min/day, on push not on commit).
# ACCEPTED: this repo's commits touch PLAN.md constantly and those files genuinely ARE read
# by tests, so the alternative is the silent-red-CI class this predicate exists to close.
# ⚠ But note the tension with this hook's own reasoning — at 94% it is close to "always
# runs", and a gate that always fires is what trains --no-verify. If push latency starts
# drawing complaints, the next move is NOT to shrink _DATA_RE (that reopens the gap) but to
# run only the tests that READ the changed data file; the keeper test already computes that
# mapping. Recorded here so whoever hits that decides with the numbers, not from scratch.
set -uo pipefail

# Resolve a real interpreter. `python` is commonly a SHELL ALIAS (zsh: alias
# python=python3) which does NOT exist in this hook's non-interactive env — so a
# bare `python` here fails with "command not found" and the gate blocks EVERY
# commit, training operators onto --no-verify. Found 2026-07-26 on a clone where
# core.hooksPath was also unset, so the gates had never run at all.
PY_BIN="${APOLLO_PY:-$(command -v python3 || command -v python || true)}"
if [ -z "$PY_BIN" ]; then
    echo "✘ pre-push: no python3 on PATH — cannot run the gates."
    echo "  Set APOLLO_PY=/path/to/python3, or bypass once with --no-verify."
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Paths whose content the SUITE READS — a change to any of these can turn the suite red
# with no .py file touched. Kept in one place, and pinned by a test (see header).
_DATA_RE='\.py$|^(CLAUDE|PLAN)\.md$|^data_gated_reviews\.ya?ml$|^docs/setups/.*\.md$|^tests/|^docker/docker-compose.*\.ya?ml$'

zero="0000000000000000000000000000000000000000"
saw_ref=0
py_changed=0
while read -r local_ref local_sha remote_ref remote_sha; do
    saw_ref=1
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$zero" ] && continue                 # branch delete — nothing to test
    if [ "$remote_sha" = "$zero" ]; then
        py_changed=1                                       # new branch/ref → run the suite
    elif git diff --name-only "$remote_sha..$local_sha" 2>/dev/null | grep -qE "$_DATA_RE"; then
        py_changed=1
    fi
done
[ "$saw_ref" -eq 0 ] && py_changed=1                       # couldn't read refs → fail-safe

if [ "$py_changed" -eq 0 ]; then
    exit 0                                       # nothing the suite reads — skip
fi

# CI runs TWO preflight gates BEFORE pytest (.github/workflows/tests.yml). This hook ran
# only pytest, so a commit could pass locally, get pushed, and red CI on a gate the hook
# never checked — exactly what happened 2026-08-09 (23 model-id literals in a new
# registry). Every red run emails the operator; his words: "so much spam from this
# everyday". Mirroring CI means matching ALL its steps, not just the slow one. Both are
# static AST walks (<1s) and run FIRST so a gate failure is instant.
for _gate in preflight_datetime_hygiene preflight_model_registry; do
    echo "▶ pre-push: $_gate (mirrors CI)…"
    if ! "$PY_BIN" "scripts/$_gate.py"; then
        echo "✘ pre-push: $_gate FAILED — push blocked (CI would reject this and email you)."
        echo "  Fix it, or bypass with: git push --no-verify (emergency only)."
        exit 1
    fi
done

# ── Docs-vs-reality drift (2026-08-29) ───────────────────────────────────────
# Operator: "how do we keep this check up to date and everything in sync?" It did not — the
# checker ran ONLY when typed by hand, so entry_pipeline.md called a live gate "BUILT OFF" for
# four weeks and lane2_grouping_v2 ran grade-affecting with no owner doc naming it.
#
# WARNS, never blocks, and that is deliberate. It reads PROD, so it fails when the server is
# unreachable or you are on a plane; blocking a push on network reachability trains people to
# --no-verify, and a bypassed gate protects nothing. The DRIFT count is what matters: it is
# reported loudly and the fix is one command away.
if [ -f scripts/live_rules.py ]; then
    echo "▶ pre-push: docs-vs-prod drift…"
    _drift="$("$PY_BIN" scripts/live_rules.py --drift-only 2>/dev/null | grep -c '^  \[DRIFT\]' || true)"
    if [ "${_drift:-0}" -gt 0 ]; then
        echo "⚠ pre-push: $_drift doc(s) contradict code or prod — NOT blocking, but fix them:"
        "$PY_BIN" scripts/live_rules.py --drift-only 2>/dev/null | grep -A 3 '^  \[DRIFT\]' || true
        echo "  An analysis built on a doc listed above is invalid on arrival."
    else
        echo "✓ pre-push: no drift between docs, code and prod."
    fi
fi

echo "▶ pre-push: running full test suite (python -m pytest tests/ -q) — mirrors CI…"
if ! "$PY_BIN" -m pytest tests/ -q; then
    echo "✘ pre-push: test suite FAILED — push blocked (this is exactly what CI would reject)."
    echo "  Fix the failures, or bypass with: git push --no-verify (emergency only)."
    exit 1
fi
echo "✓ pre-push: suite green."
exit 0
