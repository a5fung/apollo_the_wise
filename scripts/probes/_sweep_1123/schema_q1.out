Indexes:
    "mi_analyst_estimates_pk" PRIMARY KEY, btree (ticker, period_type, period_end_date, as_of_date, source)
    "idx_analyst_estimates_asof" btree (as_of_date DESC)
    "idx_analyst_estimates_ticker" btree (ticker, period_type, as_of_date DESC)
Check constraints:
    "mi_analyst_estimates_check" CHECK (valid_from_date <= as_of_date)
    "mi_analyst_estimates_period_type_check" CHECK (period_type = ANY (ARRAY['annual'::text, 'quarter'::text]))
