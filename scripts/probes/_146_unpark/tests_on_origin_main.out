    def test_every_unqualified_demotion_clears_the_stamp_derived_not_listed():
        src = (MI / "flag_detector.py").read_text().splitlines()
        sites = [i for i, ln in enumerate(src) if re.search(r'\["stage"\]\s*=\s*"unqualified"', ln)
                 and not ln.lstrip().startswith("#")]
        # compute_flag_metrics' own early returns assign via `base["stage"] = ...`; the scan's M&A / deal-pin
        # demotions assign on `r[...]` AFTER the row was persisted as TRIGGERED
        demotions = [i for i in sites if re.search(r'\br\["stage"\]', src[i])]
        assert len(demotions) >= 2, "the M&A and the deal-pin demotion sites"
        for i in demotions:
