-- SQL: SELECT date_trunc('week', a.alert_date)::date wk, COUNT(*) FILTER (WHERE a.judge_tier='HIGH') judge_high_alerts, COUNT(*) FILTER (WHERE a.judge_tier='HIGH' AND EXISTS (SELECT 1 FROM mi_judge_divergence d WHERE d.ticker=a.ticker AND d.alert_date=a.alert_date)) high_with_div_row, COUNT(*) FILTER (WHERE a.judge_tier IS NOT NULL) judged_alerts FROM mi_ep_alerts a WHERE a.alert_date >= '2026-07-27' GROUP BY 1 ORDER BY 1
