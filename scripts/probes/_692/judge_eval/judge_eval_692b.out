[{"axis":"catalyst","lit":true,"direction":"demote","note":"Earnings event is fresh, but revenue is $210M/+45% vs $128M/+4% across sources, with no SEC filing yet."},{"axis":"materiality","lit":false,"direction":"demote","note":"Cannot judge acceleration materiality for a $1.9B company until the figure is confirmed."},{"axis":"gap","lit":true,"direction":"hold","note":"13.6% gap on 8.4x RVOL at the 93rd volume percentile signals a real reaction, but this is not sufficient on its own."},{"axis":"theme","lit":false,"direction":"hold","note":"Not in an active theme."},{"axis":"narrative","lit":false,"direction":"hold","note":"Not in a narrative cohort."}]},{"case_id":"D08","class":"degradation_thin_but_complete","passed":true,"verdict":{"grade":"strong","tier":"HIGH","direction_vs_floor":"hold","materiality_tier":"material","fire_axes":["catalyst"],"confidence":0.85},"failed_predicates":[],"rationale":"A fresh 8-K earnings release shows Q2 revenue of $94M, up 41% Y/Y and accelerating from 33% the prior quarter, with full-year guidance raised 7% at the midpoint. That is the load-bearing revenue-acceleration-plus-raise signal for a growth name. With no active theme or narrative cohort, there is no basis to lift it to game_changer. The 15% gap on 10.6x pre-market RVOL confirms the market agrees.","axis_reads":[{"axis":"catalyst","lit":true,"direction":"hold","note":"8-K dated today: revenue +41% Y/Y, accelerating from 33%, FY guidance raised 7%."},{"axis":"materiality","lit":true,"direction":"hold","note":"Quarterly revenue of $94M on a $2.1B cap; acceleration plus raise is material, not transformative."},{"axis":"theme","lit":false,"direction":"hold","note":"Not in an active theme, so no lift toward game_changer."},{"axis":"narrative","lit":false,"direction":"hold","note":"Not in a narrative cohort."},{"axis":"gap","lit":true,"direction":"hold","note":"15.2% gap with 10.6x RVOL at the 95th volume percentile confirms the reaction."}]}]}
