+"""The liquidity panel on Market Breadth (Apollo #732): the breadth export's optional ``liquidity`` key.
+
+Context, not validated: display only. The panel renders what Apollo's nightly export computed (contract: Apollo's
+``docs/architecture/market_breadth_snapshot.md`` §Liquidity block) and computes nothing itself. Everything is on
+screen at once (phone: two columns of indicators, tiles side by side; nothing behind a tap).
+
+An absent key = no panel. A malformed key = no panel and no exception (the page wraps the call as well). A block
+whose ``status`` is ``unavailable`` renders one line saying so; a leg whose source failed reads "unavailable" with
+its reason under it. Nothing is clipped: long names and the trend line wrap (dense, never hidden — his 11-07 rule).
+There is no Neutral / Easing word and no bottom / top label: the only label is the caution line, shown while the
+export's ``caution.on`` is true.
+"""
+from __future__ import annotations
+
+import html
+import math
+from datetime import date
+
+TONES = ("tight", "easy", "flat")
+_GROUP_SHORT = {"credit": "Credit", "fed": "Fed", "rates": "Rates", "dollar": "Dollar", "metals": "Metals",
+                "risk": "Risk"}
+
+
+def _esc(v) -> str:
+    return html.escape(str(v))
+
+
+def _num(v) -> float | None:
+    if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):
+        return None
+    return float(v)
+
+
+def _int(v) -> int | None:
+    return v if isinstance(v, int) and not isinstance(v, bool) else None
+
+
+def _short(d) -> str:
+    """'2026-11-09' -> '11-09' (the year only when it is not the panel's own)."""
+    try:
+        return date.fromisoformat(str(d)).strftime("%m-%d")
+    except ValueError:
+        return ""
+
+
+def _tone(v) -> str:
+    return v if v in TONES else "none"
+
+
+def liquidity_problems(liq) -> list[str]:
+    """Why the optional ``liquidity`` key cannot be shown ([] = fine)."""
+    if not isinstance(liq, dict):
+        return ["liquidity is not an object"]
+    if liq.get("status") == "unavailable":
+        return []
+    out = []
+    legs = liq.get("legs")
+    if not isinstance(legs, list) or not legs or any(
+            not isinstance(l, dict) or not isinstance(l.get("name"), str) for l in legs):
+        out.append("liquidity.legs")
+    try:
+        date.fromisoformat(str(liq.get("as_of")))
+    except ValueError:
+        out.append("liquidity.as_of")
+    return out
+
+
+def liquidity_css(C: dict) -> str:
+    return f"""
+    .lq-card {{ background: {C['surface']}; border: 1px solid {C['border']}; border-radius: 12px;
+                padding: 10px 12px; margin-bottom: 16px; color: {C['text']}; }}
+    .lq-top {{ display: flex; justify-content: space-between; align-items: baseline; gap: 8px; flex-wrap: wrap; }}
+    .lq-title {{ font-size: 15px; font-weight: 700; }}
+    .lq-tag {{ font-size: 11px; font-weight: 400; color: {C['text_muted']}; margin-left: 6px; }}
+    .lq-asof {{ font-size: 11px; color: {C['text_dim']}; white-space: nowrap; }}
+    .lq-caution {{ border-left: 4px solid #F97316; background: rgba(249, 115, 22, .12); border-radius: 6px;
+                   padding: 6px 8px; margin-top: 6px; }}
+    .lq-caution b {{ color: #F97316; font-size: 14px; }}
+    .lq-caution span {{ font-size: 11.5px; color: {C['text_muted']}; }}
+    .lq-hist {{ font-size: 11px; line-height: 1.35; color: {C['text_muted']}; margin-top: 2px; }}
+    .lq-count {{ font-size: 14px; font-weight: 700; margin-top: 8px; font-variant-numeric: tabular-nums; }}
+    .lq-count span {{ font-size: 12px; font-weight: 400; color: {C['text_muted']}; }}
+    .lq-groups {{ display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 3px; margin-top: 5px; }}
+    .lq-g {{ font-size: 10.5px; text-align: center; padding: 3px 1px; border-radius: 5px; white-space: nowrap;
+             overflow: hidden; border: 1px solid {C['border']}; color: {C['text_muted']}; }}
+    .lq-g.tight {{ background: rgba(249, 115, 22, .18); color: {C['text']}; border-color: #F97316; }}
+    .lq-g.easy {{ background: {C['positive_dim']}; color: {C['text']}; border-color: {C['positive']}; }}
+    .lq-line {{ font-size: 11.5px; color: {C['text_muted']}; margin-top: 5px; line-height: 1.4;
+                font-variant-numeric: tabular-nums; }}
+    .lq-legs {{ display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 8px; margin-top: 8px; }}
+    @media (min-width: 1000px) {{ .lq-legs {{ grid-template-columns: repeat(2, minmax(0, 1fr)); }} }}
+    .lq-leg {{ min-width: 0; border-top: 1px solid {C['border']}; padding-top: 3px; }}
+    .lq-name {{ font-size: 12px; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }}
+    .lq-sub {{ font-size: 11px; line-height: 1.35; color: {C['text_muted']}; overflow-wrap: anywhere;
+               font-variant-numeric: tabular-nums; }}
+    .lq-why {{ font-size: 10.5px; color: {C['text_dim']}; }}
+    .lq-dot {{ display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px;
+               background: {C['text_dim']}; }}
+    .lq-dot.tight {{ background: #F97316; }}
+    .lq-dot.easy {{ background: {C['positive']}; }}
+    .lq-dot.sm {{ width: 6px; height: 6px; margin: 0 2px 1px 3px; }}
+    .lq-w.tight {{ color: #F97316; font-weight: 600; }}
+    .lq-w.easy {{ color: {C['positive']}; font-weight: 600; }}
+    .lq-tiles {{ display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 8px; }}
+    .lq-tile {{ border: 1px solid {C['border']}; border-radius: 8px; padding: 5px 6px; min-width: 0; }}
+    .lq-tile-h {{ font-size: 10.5px; color: {C['text_muted']}; line-height: 1.3; }}
+    .lq-tile-v {{ font-size: 15px; font-weight: 700; font-family: 'JetBrains Mono', monospace; }}
+    .lq-tile-s {{ font-size: 10.5px; line-height: 1.35; color: {C['text_muted']};
+                  font-variant-numeric: tabular-nums; }}
+    """
+
+
+def _leg_html(leg: dict) -> str:
+    name = _esc(leg.get("name", ""))
+    if leg.get("status") != "ok":
+        return (f'<div class="lq-leg"><div class="lq-name"><span class="lq-dot"></span>{name}</div>'
+                f'<div class="lq-sub">unavailable</div>'
+                + (f'<div class="lq-why">{_esc(leg["reason"])}</div>' if leg.get("reason") else "") + '</div>')
+    trend, fast = _tone(leg.get("trend")), _tone(leg.get("fast"))
+    n = _int(leg.get("trend_sessions"))
+    turn = leg.get("turn") if isinstance(leg.get("turn"), dict) else None
+    since = f' {n}d' if n is not None else ""
+    turn_txt = f' · turn {_short(turn.get("date"))}' if turn and _short(turn.get("date")) else ""
+    title = f'tight = {leg.get("tight_when", "")}; trend since {leg.get("trend_since", "")}'
+    return (f'<div class="lq-leg" title="{_esc(title)}">'
+            f'<div class="lq-name"><span class="lq-dot {trend}"></span>{name}</div>'
+            f'<div class="lq-sub"><span class="lq-w {trend}">{_esc(leg.get("trend") or "—")}</span>{since}{turn_txt}'
+            f' · fast<span class="lq-dot sm {fast}"></span>{_esc(leg.get("fast") or "—")}</div></div>')
+
+
+def _seed_tile(title: str, s, slope: bool) -> str:
+    if not isinstance(s, dict) or _num(s.get("latest")) is None:
+        return (f'<div class="lq-tile"><div class="lq-tile-h">{_esc(title)}</div>'
+                f'<div class="lq-tile-s">unavailable</div></div>')
+    bits = []
+    for key, ma in (("vs_ma20", "ma20"), ("vs_ma50", "ma50")):
+        if isinstance(s.get(key), str) and _num(s.get(ma)) is not None:
+            bits.append(f'{_esc(s[key])} {ma[2:]}d {s[ma]:.2f}')
+    tail = []
+    if slope and _num(s.get("ma20_slope_wk")) is not None:
+        tail.append(f'20d slope {s["ma20_slope_wk"]:+.2f}/wk')
+    if _num(s.get("chg_1m_pct")) is not None:
+        tail.append(f'1M {s["chg_1m_pct"]:+.1f}%')
+    return (f'<div class="lq-tile"><div class="lq-tile-h">{_esc(title)}</div>'
+            f'<div class="lq-tile-v">{s["latest"]:.2f}</div>'
+            f'<div class="lq-tile-s">{"<br>".join(bits + tail)}</div></div>')
+
+
+def _hy_tile(hy) -> str:
+    if not isinstance(hy, dict) or _num(hy.get("latest")) is None:
+        return ('<div class="lq-tile"><div class="lq-tile-h">Junk-bond spread</div>'
+                '<div class="lq-tile-s">unavailable</div></div>')
+    chg = _num(hy.get("chg_1m"))
+    sub = [f'1M {chg:+.2f} pts' if chg is not None else "", f'as of {_short(hy.get("obs_date"))}'
+           if _short(hy.get("obs_date")) else ""]
+    return ('<div class="lq-tile"><div class="lq-tile-h">Junk-bond spread</div>'
+            f'<div class="lq-tile-v">{hy["latest"]:.2f}%</div>'
+            f'<div class="lq-tile-s">{"<br>".join(x for x in sub if x)}</div></div>')
+
+
+def liquidity_panel_html(liq) -> str:
+    """ONE dense card. '' when the key is absent or malformed."""
+    if liq is None or liquidity_problems(liq):
+        return ""
+    label = _esc(liq.get("label") or "context, not validated")
+    head = (f'<div class="lq-top"><span class="lq-title">Liquidity<span class="lq-tag">{label}</span></span>'
+            f'<span class="lq-asof">as of {_esc(liq.get("as_of", "—"))}</span></div>')
+    if liq.get("status") == "unavailable":
+        return (f'<div class="lq-card">{head}<div class="lq-line">Unavailable tonight: '
+                f'{_esc(liq.get("reason") or "the nightly read failed")}.</div></div>')
+    parts = [head]
+
+    c = liq.get("caution")
+    if isinstance(c, dict) and c.get("on") is True:
+        n = _int(c.get("sessions"))
+        since = f'since {_esc(c.get("since", ""))}' + (f' · {n} sessions' if n is not None else "")
+        hist = f'<div class="lq-hist">{_esc(c["history"])}</div>' if isinstance(c.get("history"), str) else ""
+        parts.append(f'<div class="lq-caution"><b>{_esc(c.get("text") or "Caution — liquidity draining")}</b> '
+                     f'<span>{since}</span>{hist}</div>')
+
+    gt = liq.get("groups_tight")
+    if isinstance(gt, dict) and _int(gt.get("n")) is not None and _int(gt.get("of")) is not None:
+        chg = _int(gt.get("chg_20d"))
+        chg_txt = "" if chg is None else (" · unchanged vs 20 sessions ago" if chg == 0
+                                          else f' · {chg:+d} vs 20 sessions ago')
+        sc = _num(liq.get("score"))
+        sc_txt = f' · score {sc:+.1f} (−6 to +6)' if sc is not None else ""
+        parts.append(f'<div class="lq-count">{gt["n"]} of {gt["of"]} groups tight<span>{chg_txt}{sc_txt}</span></div>')
+    groups = liq.get("groups")
+    if isinstance(groups, list) and groups:
+        chips = []
+        for g in groups:
+            if not isinstance(g, dict):
+                continue
+            s = _num(g.get("score"))
+            tone = "none" if s is None else ("tight" if s > 0 else "easy" if s < 0 else "flat")
+            chips.append(f'<div class="lq-g {tone}" title="{_esc(g.get("name", ""))}: {tone}">'
+                         f'{_esc(_GROUP_SHORT.get(g.get("key"), g.get("name", "")))}</div>')
+        parts.append(f'<div class="lq-groups">{"".join(chips)}</div>')
+
+    turns = [t for t in (liq.get("composite_turns") or []) if isinstance(t, dict) and _short(t.get("date"))]
+    if turns:
+        txt = " · ".join(f'to {_esc(t["to"])} {_short(t["date"])}' for t in reversed(turns) if t.get("to") in TONES)
+        parts.append(f'<div class="lq-line">Composite turns (newest first): {txt}</div>')
+
+    n_un = len(liq.get("unavailable") or []) if isinstance(liq.get("unavailable"), list) else 0
+    if n_un:
+        parts.append(f'<div class="lq-line">{n_un} of {len(liq["legs"])} indicators unavailable tonight: they count '
+                     'as flat, so the group count and the caution line may read low.</div>')
+
+    parts.append(f'<div class="lq-legs">{"".join(_leg_html(l) for l in liq["legs"])}</div>')
+
+    seeds = liq.get("seeds") if isinstance(liq.get("seeds"), dict) else {}
+    parts.append('<div class="lq-tiles">' + _seed_tile("JNK (price)", seeds.get("jnk"), True)
+                 + _seed_tile("Gold / silver", seeds.get("gold_silver"), False) + _hy_tile(liq.get("hy_spread"))
+                 + '</div>')
+    parts.append('<div class="lq-line">Dot = trend (20-day vs 50-day average; orange tight, green easy) and the '
+                 'sessions it has held; turn = the last change that held 5 sessions; fast = vs its own 20-day.</div>')
+    return f'<div class="lq-card">{"".join(parts)}</div>'
