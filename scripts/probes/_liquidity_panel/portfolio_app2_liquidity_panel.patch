+"""Apollo #732: the liquidity panel on Market Breadth (the export's optional ``liquidity`` key).
+
+The fixture is Apollo's production block for the 2026-11-20 close (its own test pins those numbers to the reference
+read). Here: what the panel shows, that nothing is hidden behind a tap, and that a missing / broken / failed block
+never costs the page its breadth card.
+"""
+from __future__ import annotations
+
+import copy
+import json
+import os
+
+import liquidity_view as lqv
+from _breadth_page_harness import all_md as _md, run_breadth_page
+from app_palette import C_DARK, C_LIGHT
+
+_HERE = os.path.dirname(__file__)
+NIGHTLY = os.path.join(_HERE, "test_fixtures", "breadth_snapshot_2026-11-08_groups.json")
+BLOCK = os.path.join(_HERE, "test_fixtures", "liquidity_block_2026-11-20.json")
+
+
+def _liq():
+    return json.load(open(BLOCK))
+
+
+def _snap(liq="fixture"):
+    s = json.load(open(NIGHTLY))
+    if liq is not None:
+        s["liquidity"] = _liq() if liq == "fixture" else liq
+    return s
+
+
+def test_panel_shows_the_label_count_caution_and_every_leg():
+    h = lqv.liquidity_panel_html(_liq())
+    assert "context, not validated" in h and "as of 2026-11-20" in h
+    assert "3 of 6 groups tight" in h and "unchanged vs 20 sessions ago" in h and "score +2.0" in h
+    assert "Caution — liquidity draining" in h and "since 2026-10-26" in h and "33% of 730 draining days" in h
+    assert h.count('class="lq-leg"') == 10 and h.count('class="lq-g ') == 6
+    for name in ("Baa corporate spread", "Net liquidity", "Fed funds rate", "10-year real yield", "2-year yield",
+                 "Dollar (UUP)", "Gold / silver", "Copper / gold", "Small vs large", "Speculative growth"):
+        assert name in h
+    assert "Composite turns (newest first): to tight 11-09 · to easy 09-23 · to tight 06-25" in h
+    assert "\n\n" not in h          # a blank line would end the HTML block in st.markdown
+
+
+def test_a_leg_row_carries_trend_days_turn_and_fast_dot():
+    h = lqv.liquidity_panel_html(_liq())
+    i = h.index("Dollar (UUP)")
+    row = h[i:h.index("</div></div>", i)]
+    assert 'class="lq-w tight">tight</span> 41d · turn 09-30 · fast' in row and "lq-dot sm tight" in row
+
+
+def test_seed_tiles_and_the_spread():
+    h = lqv.liquidity_panel_html(_liq())
+    assert "JNK (price)" in h and ">91.54<" in h and "below 20d 92.55" in h and "below 50d 92.92" in h
+    assert "20d slope -0.13/wk" in h and "1M -1.0%" in h
+    assert "Gold / silver" in h and ">8.73<" in h and "above 20d 8.00" in h and "1M +16.8%" in h
+    assert "Junk-bond spread" in h and ">3.52%<" in h and "1M +0.25 pts" in h
+
+
+def test_no_state_word_and_no_bottom_or_top_label():
+    h = lqv.liquidity_panel_html(_liq())
+    for banned in ("Neutral", "Easing", "easing", "neutral", "bottom", "Bottom", "early marker"):
+        assert banned not in h
+    assert "<details" not in h and "<summary" not in h      # nothing behind a tap
+
+
+def test_no_caution_line_when_the_export_says_off():
+    b = _liq()
+    b["caution"] = {"on": False}
+    h = lqv.liquidity_panel_html(b)
+    assert "Caution" not in h and "lq-caution" not in h and "3 of 6 groups tight" in h
+    b["caution"] = None
+    assert "Caution" not in lqv.liquidity_panel_html(b)
+
+
+def test_an_unavailable_leg_reads_unavailable_and_is_counted():
+    b = _liq()
+    b["legs"][3] = {"id": "R1", "name": "10-year real yield", "group": "rates", "tight_when": "real yield rising",
+                    "status": "unavailable", "reason": "source failed: DFII10"}
+    b["unavailable"] = ["R1"]
+    h = lqv.liquidity_panel_html(b)
+    assert "1 of 10 indicators unavailable tonight" in h and h.count(">unavailable<") == 1
+    assert h.count('class="lq-leg"') == 10
+
+
+def test_missing_tiles_read_unavailable():
+    b = _liq()
+    b["seeds"], b["hy_spread"] = {"jnk": None, "gold_silver": None}, None
+    assert lqv.liquidity_panel_html(b).count(">unavailable<") == 3
+
+
+def test_an_unavailable_block_is_one_line():
+    h = lqv.liquidity_panel_html({"version": 1, "label": "context, not validated", "status": "unavailable",
+                                  "reason": "no daily bars: Alpaca returned nothing"})
+    assert "Unavailable tonight: no daily bars" in h and "lq-leg" not in h
+
+
+def test_absent_or_malformed_gives_no_panel_and_no_exception():
+    assert lqv.liquidity_panel_html(None) == ""
+    bad = _liq()
+    bad["legs"] = "boom"
+    noasof = _liq()
+    noasof["as_of"] = "nope"
+    for b in ("x", [], {}, {"status": "ok"}, bad, noasof, {"legs": [1], "as_of": "2026-11-20"}):
+        assert lqv.liquidity_panel_html(b) == ""
+    odd = _liq()                       # odd optional parts are skipped, never raised on
+    odd.update(groups="x", groups_tight=[1], composite_turns=[{"date": "bad"}, 5], caution="yes", score="2",
+               seeds=[1], hy_spread="x", unavailable="x")
+    odd["legs"][0].update(trend=None, fast=7, turn="x", trend_sessions="n")
+    h = lqv.liquidity_panel_html(odd)
+    assert h.count('class="lq-leg"') == 10 and "groups tight" not in h
+
+
+def test_text_is_escaped():
+    b = _liq()
+    b["legs"][0]["name"] = "<script>x</script>"
+    b["caution"]["history"] = '"><img>'
+    b["label"] = "<b>ctx</b>"
+    h = lqv.liquidity_panel_html(b)
+    assert "<script>" not in h and "<img>" not in h and "<b>ctx" not in h and "&lt;script&gt;" in h
+
+
+def test_css_builds_for_both_palettes():
+    for C in (C_DARK, C_LIGHT):
+        css = lqv.liquidity_css(C)
+        assert ".lq-card" in css and "repeat(2, minmax(0, 1fr))" in css and "repeat(3, minmax(0, 1fr))" in css
+
+
+# ── the page ──
+def _write(tmp_path, snap):
+    p = tmp_path / "s.json"
+    p.write_text(json.dumps(snap))
+    return p
+
+
+def test_page_shows_the_panel_beside_the_breadth_card(monkeypatch, tmp_path):
+    at = run_breadth_page(monkeypatch, _write(tmp_path, _snap()))
+    md = _md(at)
+    assert "3 of 6 groups tight" in md and "Caution — liquidity draining" in md and "Advances vs declines" in md
+    assert md.index("Advances vs declines") < md.index("3 of 6 groups tight")
+    assert "liquidity.trend" in md          # its definitions are printed with the export's own
+
+
+def test_page_without_the_key_is_unchanged(monkeypatch, tmp_path):
+    md = _md(run_breadth_page(monkeypatch, _write(tmp_path, _snap(liq=None))))
+    assert "groups tight" not in md and "Liquidity" not in md and "Advances vs declines" in md
+
+
+def test_page_with_a_broken_block_still_renders_breadth(monkeypatch, tmp_path):
+    for bad in ({"legs": "boom"}, "x", [1], {"status": "unavailable"}):
+        md = _md(run_breadth_page(monkeypatch, _write(tmp_path, _snap(liq=copy.deepcopy(bad)))))
+        assert "Advances vs declines" in md
+        assert ("Unavailable tonight" in md) == (bad == {"status": "unavailable"})
+
+
+def test_nothing_in_the_panel_is_clipped():
+    """Compact = dense, never hidden: no leg name, trend line or tile title is cut with an ellipsis on a phone, and an
+    unavailable leg shows its reason on screen (not only on hover)."""
+    for C in (C_LIGHT, C_DARK):
+        assert "ellipsis" not in lqv.liquidity_css(C)
+    b = _liq()
+    b["legs"][3] = {"id": "R1", "name": "10-year real yield", "group": "rates", "tight_when": "real yield rising",
+                    "status": "unavailable", "reason": "source failed: DFII10"}
+    b["unavailable"] = ["R1"]
+    assert '<div class="lq-why">source failed: DFII10</div>' in lqv.liquidity_panel_html(b)
