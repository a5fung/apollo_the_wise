== apollo-market
/app
7745-    # (_TV_LOOKBACK_DAYS) picks up every unrecorded alert on the next run. A replay of
7746-    # job_recovery.plan_recovery on boots Sat 14:00, Sun 20:00 and Mon 09:00 read every 10:10 slot
7747-    # as 'done' off the ordinary 20:45 ledger rows, so the weekend deploy itself pages nothing.
7748-    _scheduler.add_job(
7749-        audit_wrap(_tv_news_shadow_job, "tv_news_shadow"),
7750-        CronTrigger(hour=10, minute=10, day_of_week="mon-fri", timezone="America/New_York"),
7751:        id="tv_news_shadow",
7752-        replace_existing=True,
7753-        misfire_grace_time=1800,
7754-    )
agents/market_intelligence/db.py:4
agents/market_intelligence/ep_detector.py:2
agents/market_intelligence/tv_news_shadow.py:4
