FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    # Chromium dependencies for Playwright
    chromium \
    chromium-driver \
    fonts-liberation \
    libatk-bridge2.0-0 \
    libdrm2 \
    libgbm1 \
    libnss3 \
    libxss1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/finance.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install Playwright browsers
RUN playwright install chromium --with-deps

COPY agents/base.py agents/base.py
COPY agents/finance/ agents/finance/
COPY shared/ shared/
COPY integrations.yaml integrations.yaml

RUN useradd -m -u 1000 apollo && chown -R apollo:apollo /app
USER apollo

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8001

CMD ["uvicorn", "agents.finance.agent:app", "--host", "0.0.0.0", "--port", "8001"]
