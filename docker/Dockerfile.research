FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/research.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY agents/base.py agents/base.py
COPY agents/research/ agents/research/
COPY shared/ shared/
COPY integrations.yaml integrations.yaml

RUN useradd -m -u 1000 apollo && chown -R apollo:apollo /app
USER apollo

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8003

CMD ["uvicorn", "agents.research.agent:app", "--host", "0.0.0.0", "--port", "8003"]
