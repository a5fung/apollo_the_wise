FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY agents/base.py agents/base.py
COPY agents/__init__.py agents/__init__.py
COPY agents/market_intelligence/ agents/market_intelligence/
COPY shared/ shared/
COPY core/notifications.py core/notifications.py
COPY core/job_audit.py core/job_audit.py
# ALL root-level yaml runtime configs in one glob (#474, 2026-07-16): every new
# root yaml used to need a hand-added COPY here + a deploy.sh case arm; a miss =
# a stale image (theme_ecosystems.yaml cost a deploy cycle on 7/14 — 3rd
# occurrence of the class). The glob + deploy.sh's generic *.yaml arm kill it.
COPY *.yaml ./
# Existence check for the KNOWN runtime yamls (review 7/17): the glob
# alone would build green if one were renamed/moved — restoring the
# per-file build-time failure the glob removed. ADDING a yaml still
# needs no edit here; only renames/moves of these three do.
RUN test -f integrations.yaml && test -f data_gated_reviews.yaml && test -f theme_ecosystems.yaml
# PLAN.md is NOT copied (#435): it's a read-only bind-mount in docker-compose.prod.yml
# so the #426 blocking-count reflects the LIVE file (a COPY snapshot went stale on
# PLAN-only sessions that didn't rebuild the image).
COPY scripts/ scripts/

RUN useradd -m -u 1000 apollo && chown -R apollo:apollo /app
USER apollo

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8006

CMD ["uvicorn", "agents.market_intelligence.agent:app", "--host", "0.0.0.0", "--port", "8006", "--workers", "1"]
