# ============================================================
# Apollo Assistant — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789          # Comma-separated Telegram user IDs allowed to interact

# ----- Anthropic -----
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apollo
POSTGRES_USER=apollo
POSTGRES_PASSWORD=change_me_strong_password

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ----- Internal API -----
# Secret used to authenticate internal sub-agent API calls
INTERNAL_API_SECRET=change_me_internal_secret
ORCHESTRATOR_HOST=http://localhost:8000

# ----- TradingView Webhook -----
# Include this in your TradingView webhook URL as a query param: ?token=...
TRADINGVIEW_WEBHOOK_SECRET=change_me_tv_secret

# ----- Finance Agent (IBKR) -----
IBKR_CLIENT_PORTAL_URL=https://localhost:5000   # IBKR Client Portal Gateway
IBKR_ACCOUNT_ID=your_ibkr_account_id

# ----- Calendar Agent (Google) -----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CAL_TOKEN=path_or_json_of_google_token   # Path to credentials JSON or base64-encoded JSON

# ----- Calendar Agent (Apple iCloud CalDAV) -----
APPLE_CALDAV_URL=https://caldav.icloud.com
APPLE_CALDAV_USER=your_apple_id_email
APPLE_CALDAV_TOKEN=your_app_specific_password   # App-specific password from appleid.apple.com

# ----- Research Agent (Tavily) -----
TAVILY_API_KEY=your_tavily_api_key_here

# ----- Misc -----
LOG_LEVEL=INFO
ENVIRONMENT=development   # development | production
