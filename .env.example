# ============================================================
# Apollo Assistant — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ----- Telegram -----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789          # Comma-separated Telegram user IDs allowed to interact

# ----- Anthropic -----
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apollo
POSTGRES_USER=apollo
POSTGRES_PASSWORD=change_me_strong_password

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ----- Internal API -----
# Secret used to authenticate internal sub-agent API calls
INTERNAL_API_SECRET=change_me_internal_secret
ORCHESTRATOR_HOST=http://localhost:8000

# ----- TradingView Webhook -----
# Include this in your TradingView webhook URL as a query param: ?token=...
TRADINGVIEW_WEBHOOK_SECRET=change_me_tv_secret

# ----- Market Intelligence Agent -----
POLYGON_API_KEY=your_polygon_api_key_here        # polygon.io (Starter tier — EOD, reference, VIX)
FMP_API_KEY=your_fmp_api_key_here                # financialmodelingprep.com (free tier ok for POC)
PERPLEXITY_API_KEY=your_perplexity_api_key_here  # perplexity.ai — EP catalyst validation + news lookup
FINNHUB_API_KEY=your_finnhub_api_key_here        # finnhub.io — /calendar/earnings forward estimates
                                                  # (free tier; /stock/*-estimate is premium-walled)

# ----- Alpaca Broker / Market Data -----
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=true                                # true = paper account, false = live $
LIVE_TRADING_ENABLED=false                       # master kill switch for all bracket orders
CRYPTO_RS_ENABLED=false                          # false = shadow mode (ingest on, Telegram off); true = alt-season alerts active
# Realtime data feed for bar stream + REST backfill.
#   iex (default) = free, single-exchange feed (~2–3% consolidated volume)
#   sip           = CTA/UTP consolidated tape — REQUIRES Algo Trader Plus
#                   ($99/mo) subscription in the Alpaca dashboard. Without
#                   the subscription, SIP requests return 403. Flip to sip
#                   after subscribing; see Changes Made 2026-04-23 in CLAUDE.md.
ALPACA_DATA_FEED=iex

# ----- Misc -----
LOG_LEVEL=INFO
ENVIRONMENT=development   # development | production
