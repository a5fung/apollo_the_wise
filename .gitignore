# IDE
.vscode/
.idea/
*.swp

# Claude Code local settings — machine-specific (permissions, worktrees) stay OUT.
# `.claude/*` not `.claude/`: git will not descend into an excluded DIRECTORY, so an
# un-ignore below it can never match. Ignoring the CONTENTS instead makes the negation work.
.claude/*
# ...but settings.json carries the Stop hook that gates the report format (2026-08-02). A gate
# that only exists on one machine is not a gate — it must travel with the repo, and CI must be
# able to assert it is wired.
!.claude/settings.json

# #267 chart-vision eval — emitted chart PNGs (runtime output, not source)
_chart_eval/
clean_breakout_cohort.csv

# Session-scratch probe OUTPUT data (regenerable; never source) — 6/19 hygiene sweep
scripts/*.tsv
scripts/*.err
/replay268_*.csv
scripts/_catalyst_type_cohort.json
_chart_eval_267/

# session growth-gate baseline (machine-local; re-armed at OPEN)
.apollo_session_baseline.json
# day's routing declaration (machine-local; written at OPEN by delegation_report.py --route)
.apollo_routing.json

# ep_replay harness captures (regenerable from prod via scripts/ep_replay_data/_pull*.sql)
scripts/ep_replay_data/*.txt
scripts/ep_replay_data/*.tsv
scripts/ep_replay_data/*.tsv.gz
