        # ── Trading journal — user observations with auto-enriched context ─
        await conn.execute("""
            CREATE TABLE IF NOT EXISTS mi_journal_entries (
                id SERIAL PRIMARY KEY,
                entry_text TEXT NOT NULL,
                regime TEXT,
