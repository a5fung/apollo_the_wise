                proposed_at TIMESTAMPTZ,
                confirmed_at TIMESTAMPTZ,
                skip_reason TEXT,
                created_at TIMESTAMPTZ DEFAULT NOW(),
                filled_at TIMESTAMPTZ,
                closed_at TIMESTAMPTZ,
