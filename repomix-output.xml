        # Manual trigger: 'trade 9m TICKER'
        manual_match = _re.search(r'trade\s+9m\s+([A-Z]{1,5})', request.task.upper())
        if manual_match:
            ticker = manual_match.group(1)
            from agents.market_intelligence.db import get_pending_9m_sugar_babies
