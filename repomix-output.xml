        "annual_revenue": [],
        "next_earnings_date": None,
        "quality_flags": {
            "eps_accelerating": accelerating,
            "eps_streak_25pct": streak,
            "sales_confirms": sales_confirms,
            "gross_margin_trend": "stable",
