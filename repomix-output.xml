            SELECT id, ticker, alert_date, status, entry_price, entry_shares,
                   stop_price, orb_high, orb_low, total_pnl, gap_pct,
                   remaining_shares, filled_at, closed_at, created_at
            FROM mi_live_trades
            WHERE catalyst_quality = '9m_volume'
